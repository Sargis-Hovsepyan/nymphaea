    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^3.2.7"
  }
}
